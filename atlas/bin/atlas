    CONSOLE.print(dim("NVIDIA logs:") + " atlas nvidia logs")
    CONSOLE.print(dim("HuggingFace logs:") + " atlas huggingface logs")
    CONSOLE.print()
    CONSOLE.print(yellow("Use atlas logs <component> for individual streams"))
    return 0

# ---------------------------------------------------------------------------
# Interactive install wizard
# ---------------------------------------------------------------------------
def cmd_install():
    CONSOLE.print()
    CONSOLE.print(Panel.fit(
        "[bold]Welcome to Atlas[/bold]\n\n"
        "What would you like to install?",
        width=52,
        border_style="cyan",
    ))
    CONSOLE.print()
    options = ["Full Atlas", "Proxy Only", "OpenRouter Creator", "NVIDIA Creator", "HuggingFace Creator", "Prompt Pack"]
    for i, opt in enumerate(options, 1):
        CONSOLE.print(f"  {cyan(f'{i}')} {opt}")
    CONSOLE.print()
    choice = Prompt.ask("Select", choices=[str(i) for i in range(1,7)], default="1")
    idx = int(choice) - 1
    CONSOLE.print()

    if idx == 0:
        _install_full()
    elif idx == 1:
        _install_proxy()
    elif idx == 2:
        _install_openrouter()
    elif idx == 3:
        _install_nvidia()
    elif idx == 4:
        _install_huggingface()
    elif idx == 5:
        _install_prompt_pack()
    return 0

def _install_full():
    _step_progress("Environment setup", _setup_env)
    _step_progress("Dependencies", _install_deps)
    _step_progress("Proxy service", _setup_proxy)
    _step_progress("OpenRouter automation", _setup_openrouter)
    _step_progress("NVIDIA automation", _setup_nvidia)
    _step_progress("HuggingFace automation", _setup_huggingface)
    CONSOLE.print(f"\n{green('✔')} Full Atlas installation complete!")
    CONSOLE.print(f"  Try: {cyan('atlas status')}")

def _install_proxy():
    _step_progress("Environment setup", _setup_env)
    _step_progress("Dependencies", _install_deps)
    _step_progress("Proxy service", _setup_proxy)
    CONSOLE.print(f"\n{green('✔')} Proxy installation complete!")
    CONSOLE.print(f"  Try: {cyan('atlas proxy status')}")

def _install_openrouter():
    _step_progress("OpenRouter automation", _setup_openrouter)
    CONSOLE.print(f"\n{green('✔')} OpenRouter setup complete!")

def _install_nvidia():
    _step_progress("NVIDIA automation", _setup_nvidia)
    CONSOLE.print(f"\n{green('✔')} NVIDIA setup complete!")

def _install_huggingface():
    _step_progress("HuggingFace automation", _setup_huggingface)
    CONSOLE.print(f"\n{green('✔')} HuggingFace setup complete!")

def _install_prompt_pack():
    CONSOLE.print(f"  {cyan('▶')} Prompt Pack is included in the Atlas Bundle")
    CONSOLE.print(f"  {dim('Get it at https://atlas.dev')}")

def _step_progress(name, fn):
    with Progress(
        SpinnerColumn("dots12", style="cyan"),
        TextColumn("[bold]{task.description}[/bold]"),
        TextColumn("[dim]{task.fields[status]}[/dim]"),
        console=CONSOLE,
    ) as progress:
        task = progress.add_task(name, status="working...")
        try:
            fn()
            progress.update(task, status="done")
        except Exception as e:
            progress.update(task, status=f"failed: {e}")
            CONSOLE.print(f"  {red('✘')} {name}: {e}")

def _setup_env():
    pass

def _install_deps():
    venv = PROJECT_ROOT / ".venv" / "bin" / "python"
    if not venv.exists():
        CONSOLE.print(yellow("  No venv found — creating..."))
        _run([sys.executable, "-m", "venv", str(PROJECT_ROOT / ".venv")])
    CONSOLE.print(green("  Dependencies OK"))

def _setup_proxy():
    if has_systemctl():
        service_action("enable", "atlas-proxy")
    CONSOLE.print(green("  Proxy configured"))

def _setup_openrouter():
    CONSOLE.print(green("  OpenRouter automation ready"))

def _setup_nvidia():
    """Install NVIDIA automation as a systemd service."""
    service_file = SYSTEMD_DIR / "nvidia-automation.service"
    if service_file.exists() and has_systemctl():
        import shutil as sh
        dest = Path("/etc/systemd/system/nvidia-automation.service")
        sh.copy(str(service_file), str(dest))
        _run(["systemctl", "daemon-reload"], check=False, capture=True)
        _run(["systemctl", "enable", "nvidia-automation.service"], check=False, capture=True)
        CONSOLE.print(green("  NVIDIA systemd service installed"))
    CONSOLE.print(green("  NVIDIA automation ready"))

    CONSOLE.print(green("  NVIDIA automation ready"))

def _setup_huggingface():
    """Install HuggingFace automation as a systemd service."""
    service_file = SYSTEMD_DIR / "huggingface-automation.service"
    if service_file.exists() and has_systemctl():
        import shutil as sh
        dest = Path("/etc/systemd/system/huggingface-automation.service")
        sh.copy(str(service_file), str(dest))
        _run(["systemctl", "daemon-reload"], check=False, capture=True)
        _run(["systemctl", "enable", "huggingface-automation.service"], check=False, capture=True)
        CONSOLE.print(green("  HuggingFace systemd service installed"))
    CONSOLE.print(green("  HuggingFace automation ready"))

    CONSOLE.print(green("  HuggingFace automation ready"))

