# ---------------------------------------------------------------------------
# HuggingFace commands
# ---------------------------------------------------------------------------
def cmd_huggingface_start():
    hf_dir = PROJECT_ROOT / "huggingface"
    scheduler = hf_dir / "scripts" / "hf_scheduler.py"
    if not scheduler.exists():
        CONSOLE.print(red(f"ERR: {scheduler} not found"))
        return 1
    CONSOLE.print(f"{cyan('▶')} Starting HuggingFace automation...")
    result = _run(["pgrep", "-f", f"{PROJECT_ROOT}/huggingface/scripts/hf_scheduler.py"], check=False, capture=True)
    if result.returncode == 0:
        CONSOLE.print(yellow("HuggingFace automation is already running"))
        return 0
    if has_systemctl():
        check = _run(["systemctl", "list-unit-files", HF_SERVICE], check=False, capture=True)
        if HF_SERVICE in check.stdout:
            return service_action("start", HF_SERVICE)
    venv_python = PROJECT_ROOT / ".venv" / "bin" / "python"
    if not venv_python.exists():
        venv_python = Path(shutil.which("python3") or "python3")
    log_file = hf_dir / "logs" / "huggingface.log"
    log_file.parent.mkdir(parents=True, exist_ok=True)
    with open(log_file, "a") as log:
        proc = subprocess.Popen(
            [str(venv_python), str(scheduler), "--runs", "0", "--delay", "240"],
            stdout=log, stderr=subprocess.STDOUT, start_new_session=True,
        )
    CONSOLE.print(green(f"HuggingFace automation started (PID {proc.pid})"))
    CONSOLE.print(f"  Logs: {dim(str(log_file))}")
    return 0

def cmd_huggingface_stop():
    CONSOLE.print(f"{cyan('▶')} Stopping HuggingFace automation...")
    if has_systemctl():
        _run(["systemctl", "stop", HF_SERVICE], check=False)
    _run(["pkill", "-f", f"{PROJECT_ROOT}/huggingface/scripts/hf_scheduler.py"], check=False)
    _run(["pkill", "-f", f"{PROJECT_ROOT}/huggingface/scripts/main.py"], check=False)
    _run(["pkill", "-f", f"{PROJECT_ROOT}/huggingface/scripts/get_cookie.py"], check=False)
    CONSOLE.print(green("HuggingFace automation stopped"))
    return 0

def cmd_huggingface_restart():
    CONSOLE.print(f"{cyan('▶')} Restarting HuggingFace automation...")
    cmd_huggingface_stop()
    time.sleep(1)
    return cmd_huggingface_start()

def cmd_huggingface_logs():
    CONSOLE.print(f"{cyan('▶')} Following HuggingFace logs (Ctrl-C to exit)...")
    # Check if running via systemd
    if has_systemctl():
        status = _run(["systemctl", "is-active", HF_SERVICE], check=False, capture=True)
        if status.stdout.strip() == "active":
            CONSOLE.print(dim(f"  journalctl -u {HF_SERVICE} -f --output=cat"))
            try:
                subprocess.run(["journalctl", "-u", HF_SERVICE, "-f", "--no-pager", "--output=cat"], check=False)
            except KeyboardInterrupt:
                CONSOLE.print()
            return 0
    # Daemon-mode log (atlas_core) takes precedence over legacy path
    daemon_log = PROJECT_ROOT / "data" / "logs" / "huggingface.log"
    if not has_systemctl() and daemon_log.exists():
        try:
            from atlas_core.process import tail_log
            tail_log("huggingface", follow=True)
        except KeyboardInterrupt:
            pass
        return 0
    # Fallback: check the log file
    log_file = PROJECT_ROOT / "huggingface" / "logs" / "huggingface.log"
    if not log_file.exists():
        CONSOLE.print(yellow("No log file yet — start the automation first"))
        return 0
    try:
        subprocess.run(["tail", "-f", str(log_file)], check=False)
    except KeyboardInterrupt:
        CONSOLE.print()
    return 0

def cmd_huggingface_status():
    CONSOLE.print(f"\n{bold('HuggingFace Automation')}")
    result = _run(["pgrep", "-f", f"{PROJECT_ROOT}/huggingface/scripts/hf_scheduler.py"], check=False, capture=True)
    if result.returncode == 0:
        CONSOLE.print(f"  {green('✔')} Running (PID {result.stdout.strip()})")
    else:
        CONSOLE.print(f"  {yellow('✘')} Not running")
    hf_keys = HF_KEYS_FILE
    if hf_keys.exists():
        count = len([k for k in hf_keys.read_text().strip().splitlines() if k.strip() and not k.startswith("#")])
        CONSOLE.print(f"  Keys: {cyan(str(count))}")
    return 0

def cmd_huggingface_keys() -> int:
    hf_keys = HF_KEYS_FILE
    if hf_keys.exists():
        content = hf_keys.read_text().strip()
        keys = [k for k in content.splitlines() if k.strip() and not k.startswith("#")]
        CONSOLE.print(f"\n{bold('HuggingFace Keys')}")
        CONSOLE.print(f"  Total: {cyan(str(len(keys)))}")
        CONSOLE.print()
        for i, k in enumerate(keys, 1):
            CONSOLE.print(f"  {dim(f'{i}.')} {k[:40]}...")
    else:
        CONSOLE.print(f"\n{yellow('No HuggingFace keys found')}")
        CONSOLE.print(f"  Run {cyan('atlas huggingface create')} to generate one")
    return 0

def cmd_huggingface_create() -> int:
    CONSOLE.print(f"\n{cyan('▶')} Creating HuggingFace key...")
    CONSOLE.print(f"  {dim('This requires a Google account login and CAPTCHA')}")
    CONSOLE.print()

    # Check if CDP is available
    try:
        import urllib.request
        req = urllib.request.Request("http://127.0.0.1:9333/json/version", timeout=3)
        with urllib.request.urlopen(req, timeout=3) as resp:
            CONSOLE.print(green("  CDP available on port 9333"))
    except Exception:
        CONSOLE.print(yellow("  CDP not available on port 9333"))
        CONSOLE.print(f"  Start Chrome with: {cyan('--remote-debugging-port=9333')}")
        return 1

    venv_python = PROJECT_ROOT / ".venv" / "bin" / "python"
    if not venv_python.exists():
        venv_python = Path(shutil.which("python3") or "python3")

    hf_main = PROJECT_ROOT / "huggingface" / "scripts" / "main.py"
    if not hf_main.exists():
        CONSOLE.print(red(f"  ERR: {hf_main} not found"))
        return 1

    with Progress(
        SpinnerColumn("dots12", style="cyan"),
        TextColumn("[bold]{task.description}[/bold]"),
        BarColumn(),
        TaskProgressColumn(),
        console=CONSOLE,
    ) as progress:
        task = progress.add_task("Generating HuggingFace key...", total=1)
        try:
            result = subprocess.run(
                [str(venv_python), str(hf_main)],
                capture_output=True, text=True, timeout=600,
            )
            progress.update(task, completed=1)
        except subprocess.TimeoutExpired:
            progress.update(task, completed=0)
            CONSOLE.print(red("  Key generation timed out"))
            return 1
        except Exception as e:
            progress.update(task, completed=0)
            CONSOLE.print(red(f"  Failed: {e}"))
            return 1

    if result.returncode == 0:
        CONSOLE.print(green("  HuggingFace key generated successfully"))
        hf_keys = HF_KEYS_FILE
        if hf_keys.exists():
            keys = [k for k in hf_keys.read_text().strip().splitlines() if k.strip()]
            CONSOLE.print(f"  Total keys now: {cyan(str(len(keys)))}")
    else:
        CONSOLE.print(red(f"  Key generation failed (exit {result.returncode})"))
        if result.stderr:
            CONSOLE.print(dim(result.stderr.strip()[:500]))
    return 0

def cmd_huggingface_import() -> int:
    CONSOLE.print(f"\n{cyan('▶')} Import HuggingFace key")
    CONSOLE.print(f"  Paste your hf_... key below")
    CONSOLE.print()

    key = Prompt.ask("HuggingFace API key")
    if not key or not key.startswith("hf_"):
        CONSOLE.print(red("  Invalid key format. Must start with hf_"))
        return 1

    hf_keys = HF_KEYS_FILE
    hf_keys.parent.mkdir(parents=True, exist_ok=True)

    existing = set()
    if hf_keys.exists():
        content = hf_keys.read_text().strip()
        existing = {k.strip() for k in content.splitlines() if k.strip() and not k.startswith("#")}

    if key in existing:
        CONSOLE.print(yellow("  Key already exists"))
        return 0

    with open(hf_keys, "a") as f:
        f.write(f"{key}\n")

    CONSOLE.print(green("  Key imported successfully"))
    CONSOLE.print(f"  Total keys: {cyan(str(len(existing) + 1))}")
    return 0


# ---------------------------------------------------------------------------
# Keys command (existing, now also handles component-specific keys)
# ---------------------------------------------------------------------------
def cmd_keys() -> int:
    CONSOLE.print(f"\n{bold('Atlas Keys')}")
    or_keys = OR_KEYS_FILE
    nv_keys = NV_KEYS_FILE
    hf_keys = HF_KEYS_FILE

    if or_keys.exists():
        content = or_keys.read_text().strip()
        keys = [k for k in content.splitlines() if k.strip() and not k.startswith("#")]
        CONSOLE.print(f"\n  {bold('OpenRouter')}: {cyan(str(len(keys)))} keys")
        for i, k in enumerate(keys[:3], 1):
            CONSOLE.print(f"    {i}. {dim(k[:20])}...")
        if len(keys) > 3:
            CONSOLE.print(f"    ... and {len(keys) - 3} more")
    else:
        CONSOLE.print(f"\n  {yellow('OpenRouter')}: No keys file found")

    if nv_keys.exists():
        content = nv_keys.read_text().strip()
        keys = [k for k in content.splitlines() if k.strip() and not k.startswith("#")]
        CONSOLE.print(f"\n  {bold('NVIDIA')}: {cyan(str(len(keys)))} keys")
        for i, k in enumerate(keys[:3], 1):
            CONSOLE.print(f"    {i}. {dim(k[:20])}...")
        if len(keys) > 3:
            CONSOLE.print(f"    ... and {len(keys) - 3} more")
    else:
        CONSOLE.print(f"\n  {yellow('NVIDIA')}: No keys file found")
    if hf_keys.exists():
        content = hf_keys.read_text().strip()
        keys = [k for k in content.splitlines() if k.strip() and not k.startswith("#")]
        CONSOLE.print(f"\n  {bold('HuggingFace')}: {cyan(str(len(keys)))} keys")
        for i, k in enumerate(keys[:3], 1):
            CONSOLE.print(f"    {i}. {dim(k[:20])}...")
        if len(keys) > 3:
            CONSOLE.print(f"    ... and {len(keys) - 3} more")
    else:
        CONSOLE.print(f"\n  {yellow('HuggingFace')}: No keys file found")

    return 0

# ---------------------------------------------------------------------------
# Shell command
# ---------------------------------------------------------------------------
def cmd_shell() -> int:
    env = os.environ.copy()
    env["ATLAS_PROXY_URL"] = os.environ.get("ATLAS_PROXY_URL", "http://127.0.0.1:8788")
    env["ATLAS_SERVICE"] = os.environ.get("ATLAS_SERVICE", PROXY_SERVICE)
    env["ANTHROPIC_BASE_URL"] = "http://127.0.0.1:8788"
    env["ANTHROPIC_API_KEY"] = "atlas"
    env["ATLAS_ROOT"] = str(PROJECT_ROOT)
    shell = detect_shell()
    CONSOLE.print(f"{cyan('▶')} Opening {shell} with Atlas environment...")
    CONSOLE.print(f"  ANTHROPIC_BASE_URL = http://127.0.0.1:8788")
    CONSOLE.print(f"  ATLAS_PROXY_URL = {env['ATLAS_PROXY_URL']}")
    CONSOLE.print()
    subprocess.run([shell], env=env)
    return 0

# ---------------------------------------------------------------------------
# Update command
# ---------------------------------------------------------------------------
def cmd_update() -> int:
    CONSOLE.print(f"{cyan('▶')} Pulling latest changes...")
    result = _run(["git", "pull"], cwd=PROJECT_ROOT, check=False, capture=True)
    if result.returncode == 0:
        CONSOLE.print(green("Pulled latest changes"))
    else:
        CONSOLE.print(yellow(f"Git pull: {result.stderr.strip()}"))
    CONSOLE.print(f"{cyan('▶')} Reconfiguring...")
    return cmd_install()

# ---------------------------------------------------------------------------
# Main dispatcher with fuzzy matching
# ---------------------------------------------------------------------------

COMPONENTS = ["proxy", "openrouter", "nvidia", "huggingface"]
ALL_COMMANDS = [
    "install", "doctor", "update", "shell", "status", "logs",
    "restart", "stop", "start", "help", "keys", "test",
    "proxy", "openrouter", "nvidia", "huggingface",
]

def _dispatch_proxy(args):
    cmd = getattr(args, "proxy_cmd", None)
    if cmd == "start": return cmd_proxy_start()
    elif cmd == "stop": return cmd_proxy_stop()
    elif cmd == "restart": return cmd_proxy_restart()
    elif cmd == "logs": return cmd_proxy_logs()
    elif cmd == "status": return cmd_proxy_status()
    else:
        CONSOLE.print("Usage: atlas proxy <start|stop|restart|logs|status>")
        return 1

def _dispatch_openrouter(args):
    cmd = getattr(args, "or_cmd", None)
    if cmd == "start": return cmd_openrouter_start()
    elif cmd == "stop": return cmd_openrouter_stop()
    elif cmd == "restart": return cmd_openrouter_restart()
    elif cmd == "logs": return cmd_openrouter_logs()
    elif cmd == "status": return cmd_openrouter_status()
    elif cmd == "keys": return cmd_openrouter_keys()
    elif cmd == "create": return cmd_openrouter_create()
    elif cmd == "import": return cmd_openrouter_import()
    else:
        CONSOLE.print("Usage: atlas openrouter <start|stop|restart|logs|status|keys|create|import>")
        return 1

def _dispatch_nvidia(args):
    cmd = getattr(args, "nv_cmd", None)
    if cmd == "start": return cmd_nvidia_start()
    elif cmd == "stop": return cmd_nvidia_stop()
    elif cmd == "restart": return cmd_nvidia_restart()
    elif cmd == "logs": return cmd_nvidia_logs()
    elif cmd == "status": return cmd_nvidia_status()
    elif cmd == "keys": return cmd_nvidia_keys()
    elif cmd == "create": return cmd_nvidia_create()
    elif cmd == "import": return cmd_nvidia_import()
    else:
        CONSOLE.print("Usage: atlas nvidia <start|stop|restart|logs|status|keys|create|import>")
        return 1

def _dispatch_huggingface(args):
    cmd = getattr(args, "hf_cmd", None)
    if cmd == "start": return cmd_huggingface_start()
    elif cmd == "stop": return cmd_huggingface_stop()
    elif cmd == "restart": return cmd_huggingface_restart()
    elif cmd == "logs": return cmd_huggingface_logs()
    elif cmd == "status": return cmd_huggingface_status()
    elif cmd == "keys": return cmd_huggingface_keys()
    elif cmd == "create": return cmd_huggingface_create()
    elif cmd == "import": return cmd_huggingface_import()
    else:
        CONSOLE.print("Usage: atlas huggingface <start|stop|restart|logs|status|keys|create|import>")
        return 1

def _handle_global(args):
    cmd = args.global_cmd
    if cmd == "start": return cmd_start_all()
    elif cmd == "stop": return cmd_stop_all()
    elif cmd == "restart": return cmd_restart_all()
    elif cmd == "status": return cmd_status_all()
    elif cmd == "logs": return cmd_logs_all()
    return 0

def main() -> int:
    # If no args, show help
    if len(sys.argv) == 1:
        cmd_help()
        return 0

    # Parse the first argument as the command
    raw_cmd = sys.argv[1]

    # Handle help flags
    if raw_cmd in ("help", "--help", "-h"):
        cmd_help()
        return 0

    # Fuzzy match the command
    matched = _suggest(raw_cmd, ALL_COMMANDS)
    if matched and matched != raw_cmd:
        CONSOLE.print(f"{yellow('Unknown command:')} {red(raw_cmd)}")
        CONSOLE.print(f"\n  Did you mean:")
        CONSOLE.print(f"    atlas {matched}")
        CONSOLE.print()
        return 1

    if raw_cmd not in ALL_COMMANDS and not matched:
        # Check if it's a component prefix
        component_match = None
        for comp in COMPONENTS:
            if comp.startswith(raw_cmd.lower()):
                component_match = comp
                break
        if component_match:
            CONSOLE.print(f"{yellow('Unknown command:')} {red(raw_cmd)}")
            CONSOLE.print(f"\n  Did you mean:")
            CONSOLE.print(f"    atlas {component_match}")
            CONSOLE.print()
            return 1

        CONSOLE.print(f"{red('Unknown command:')} {raw_cmd}")
        CONSOLE.print(f"\n  Run {cyan('atlas help')} for available commands.")
        return 1

    # Now build a proper sub-argparse for the matched command
    # We use the raw command (not the fuzzy-matched one) for dispatch
    cmd = raw_cmd

    # Global proxy commands
    if cmd in ("start", "stop", "restart", "status", "logs"):
        if cmd in ("start", "restart"):
            _provider = "openrouter"
            _model = ""

            _args = sys.argv[2:]
            _i = 0

            while _i < len(_args):
                _arg = _args[_i]

                if _arg in ("--huggingface", "--hf"):
                    _provider = "huggingface"

                    # Optional model immediately following the provider flag.
                    if _i + 1 < len(_args):
                        _next = _args[_i + 1]
                        if not _next.startswith("--") and _next != "all":
                            _model = _next
                            _i += 1

                elif _arg.startswith("--huggingface="):
                    _provider = "huggingface"
                    _model = _arg.split("=", 1)[1]

                elif _arg in ("--openrouter", "--or"):
                    _provider = "openrouter"

                    # OpenRouter uses config.py default unless explicitly
                    # given a model.
                    if _i + 1 < len(_args):
                        _next = _args[_i + 1]
                        if not _next.startswith("--") and _next != "all":
                            _model = _next
                            _i += 1

                elif _arg.startswith("--openrouter="):
                    _provider = "openrouter"
                    _model = _arg.split("=", 1)[1]

                _i += 1

            # Always explicitly write the selected provider.
            # An unqualified start/restart therefore resets to OpenRouter
            # instead of inheriting the previous provider.
            if _provider == "huggingface":
                _write_runtime_provider("huggingface", _model)
            else:
                _write_runtime_provider("openrouter", _model)

            if cmd == "start":
                return cmd_proxy_start()

            cmd_proxy_stop()
            time.sleep(1)
            return cmd_proxy_start()

        # Check if "all" was passed
        if len(sys.argv) > 2 and sys.argv[2] == "all":
            class Args:
                pass
            args = Args()
            args.global_cmd = cmd
            return _handle_global(args)

        if cmd == "stop":
            return cmd_proxy_stop()
        elif cmd == "logs":
            return cmd_proxy_logs()
        elif cmd == "status":
            return cmd_proxy_status()

    # Component commands
    if cmd == "proxy":
        parser = argparse.ArgumentParser(prog="atlas proxy")
        sub = parser.add_subparsers(dest="proxy_cmd")
        sub.add_parser("start"); sub.add_parser("stop")
        sub.add_parser("restart"); sub.add_parser("logs"); sub.add_parser("status")
        args = parser.parse_args(sys.argv[2:])
        return _dispatch_proxy(args)

    elif cmd == "openrouter":
        parser = argparse.ArgumentParser(prog="atlas openrouter")
        sub = parser.add_subparsers(dest="or_cmd")
        sub.add_parser("start"); sub.add_parser("stop")
        sub.add_parser("restart"); sub.add_parser("logs"); sub.add_parser("status")
        sub.add_parser("keys"); sub.add_parser("create"); sub.add_parser("import")
        args = parser.parse_args(sys.argv[2:])
        return _dispatch_openrouter(args)

    elif cmd == "nvidia":
        parser = argparse.ArgumentParser(prog="atlas nvidia")
        sub = parser.add_subparsers(dest="nv_cmd")
        sub.add_parser("start"); sub.add_parser("stop")
        sub.add_parser("restart"); sub.add_parser("logs"); sub.add_parser("status")
        sub.add_parser("keys"); sub.add_parser("create"); sub.add_parser("import")
        args = parser.parse_args(sys.argv[2:])
        return _dispatch_nvidia(args)

    elif cmd == "huggingface":
        parser = argparse.ArgumentParser(prog="atlas huggingface")
        sub = parser.add_subparsers(dest="hf_cmd")
        sub.add_parser("start"); sub.add_parser("stop")
        sub.add_parser("restart"); sub.add_parser("logs"); sub.add_parser("status")
        sub.add_parser("keys"); sub.add_parser("create"); sub.add_parser("import")
        args = parser.parse_args(sys.argv[2:])
        return _dispatch_huggingface(args)

    elif cmd == "install":
        return cmd_install()
    elif cmd == "doctor":
        return cmd_doctor_tui(sys.argv[2:])
    elif cmd == "update":
        return cmd_update()
    elif cmd == "shell":
        return cmd_shell()
    elif cmd == "status":
        return cmd_status_all()
    elif cmd == "logs":
        return cmd_logs_all()
    elif cmd == "restart":
        return cmd_restart_all()
    elif cmd == "stop":
        return cmd_stop_all()
    elif cmd == "start":
        return cmd_start_all()
    elif cmd == "keys":
        return cmd_keys()
    elif cmd == "help":
        cmd_help()
        return 0
    elif cmd == "test":
        test_parser = argparse.ArgumentParser(prog="atlas test")
        test_sub = test_parser.add_subparsers(dest="test_suite")
        test_sub.add_parser("all")
        test_sub.add_parser("openrouter")
        test_sub.add_parser("nvidia")
        test_sub.add_parser("huggingface")
        test_sub.add_parser("atlas")
        test_sub.add_parser("installer")
        test_sub.add_parser("integration")
        test_sub.add_parser("setup")
        args = test_parser.parse_args(sys.argv[2:])
        return cmd_test(args)

    CONSOLE.print(f"{red('Unknown command:')} {cmd}")
    return 1

# ---------------------------------------------------------------------------
# Test commands
# ---------------------------------------------------------------------------
TEST_SUITES = {
    "atlas": "tests/proxy_tests/",
    "proxy": "tests/proxy_tests/",
    "openrouter": "tests/openrouter_tests/",
    "nvidia": "tests/nvidia_tests/",
    "huggingface": "tests/huggingface_tests/",
    "installer": "tests/installer/",
    "integration": "tests/integration/",
    "setup": "tests/setup/",
}

def cmd_test(args) -> int:
    """Run tests for a specific project or all projects."""
    suite = getattr(args, "test_suite", None)
    if suite == "all":
        return _run_all_tests()
    elif suite and suite in TEST_SUITES:
        return _run_suite(suite, TEST_SUITES[suite])
    elif suite:
        match = _suggest(suite, list(TEST_SUITES.keys()))
        if match:
            CONSOLE.print(f"{red('Unknown test suite:')} {suite}")
            CONSOLE.print(f"\n  Did you mean:\n    atlas test {match}")
            return 1
        CONSOLE.print(f"{red('Unknown test suite:')} {suite}")
        CONSOLE.print(f"  Use {cyan('atlas test all')} to run everything")
        CONSOLE.print(f"\n  Available: {', '.join(TEST_SUITES.keys())}")
        return 1
    else:
        return _run_all_tests()

def _run_all_tests() -> int:
    CONSOLE.print(f"\n{bold('Atlas Test Suite')}")
    CONSOLE.print()

    total_passed = 0
    total_failed = 0
    total_skipped = 0
    total_time = 0.0
    has_failure = False

    for name, path in TEST_SUITES.items():
        result = _run_suite(name, path)
        if result["failed"] > 0:
            has_failure = True

    CONSOLE.print()
    if has_failure:
        CONSOLE.print(yellow("Some tests failed. Review output above."))
        return 1
    else:
        CONSOLE.print(green("All tests passed!"))
        return 0

def _run_suite(name: str, path: str) -> dict:
    CONSOLE.print(f"{cyan('▶')} Running {bold(name)} tests...")

    venv_python = PROJECT_ROOT / ".venv" / "bin" / "python"
    if not venv_python.exists():
        venv_python = Path(shutil.which("python3") or "python3")

    start = time.time()
    try:
        result = subprocess.run(
            [str(venv_python), "-m", "pytest", path, "-v", "--tb=short", "--no-header"],
            capture_output=True, text=True, timeout=120, cwd=PROJECT_ROOT,
        )
        elapsed = round(time.time() - start, 1)

        # Parse output
        output = result.stdout + result.stderr
        passed = failed = skipped = 0
        for line in output.splitlines():
            if "passed" in line:
                parts = line.split()
                for i, p in enumerate(parts):
                    if p == "passed" and i > 0:
                        try: passed = int(parts[i - 1])
                        except ValueError: pass
            if "failed" in line:
                parts = line.split()
                for i, p in enumerate(parts):
                    if p == "failed" and i > 0:
                        try: failed = int(parts[i - 1])
                        except ValueError: pass
            if "skipped" in line:
                parts = line.split()
                for i, p in enumerate(parts):
                    if p == "skipped" and i > 0:
                        try: skipped = int(parts[i - 1])
                        except ValueError: pass

        status = green("OK") if failed == 0 else red("FAIL")
        CONSOLE.print(f"  {status} {passed} passed, {failed} failed, {skipped} skipped ({elapsed}s)")
        CONSOLE.print()

        return {"name": name, "passed": passed, "failed": failed, "skipped": skipped, "elapsed": elapsed, "returncode": result.returncode}
    except subprocess.TimeoutExpired:
        elapsed = round(time.time() - start, 1)
        CONSOLE.print(red(f"  Timed out after 120s"))
        CONSOLE.print()
        return {"name": name, "passed": 0, "failed": -1, "skipped": 0, "elapsed": elapsed, "returncode": 1}
    except Exception as e:
        elapsed = round(time.time() - start, 1)
        CONSOLE.print(red(f"  Error: {e}"))
        CONSOLE.print()
        return {"name": name, "passed": 0, "failed": -1, "skipped": 0, "elapsed": elapsed, "returncode": 1}

