# ---------------------------------------------------------------------------
# Doctor command
# ---------------------------------------------------------------------------
def cmd_doctor() -> int:
    CONSOLE.print(f"\n{bold('Atlas Doctor')}")
    CONSOLE.print()
    issues = []

    py_ver = sys.version_info
    if py_ver < (3, 10):
        issues.append(("Python", f"Need 3.10+, have {py_ver.major}.{py_ver.minor}"))
    else:
        CONSOLE.print(f"  {green('✔')} Python {py_ver.major}.{py_ver.minor}.{py_ver.micro}")

    for path in [
        PROJECT_ROOT / "proxy" / "main.py",
        PROJECT_ROOT / "proxy" / "config.py",
        PROJECT_ROOT / "proxy" / "keypool.py",
    ]:
        if path.exists():
            CONSOLE.print(f"  {green('✔')} {path.relative_to(PROJECT_ROOT)}")
        else:
            issues.append(("Project file", f"Missing: {path}"))
            CONSOLE.print(f"  {red('✘')} {path.relative_to(PROJECT_ROOT)}")

    venv = PROJECT_ROOT / ".venv" / "bin" / "python"
    if venv.exists():
        CONSOLE.print(f"  {green('✔')} Virtualenv at .venv")
    else:
        issues.append(("Virtualenv", "No .venv found"))
        CONSOLE.print(f"  {yellow('⚠')} No virtualenv — run 'atlas install'")

    if has_systemctl():
        CONSOLE.print(f"  {green('✔')} systemctl available")
    else:
        issues.append(("systemd", "systemctl not found"))
        CONSOLE.print(f"  {yellow('⚠')} systemctl not found")

    url = get_proxy_url()
    try:
        import urllib.request
        req = urllib.request.Request(f"{url}/health", headers={"User-Agent": "atlas-cli/2.0"})
        with urllib.request.urlopen(req, timeout=3) as resp:
            CONSOLE.print(f"  {green('✔')} Proxy responding on {url}")
    except Exception:
        issues.append(("Proxy", f"Proxy not responding on {url}"))
        CONSOLE.print(f"  {yellow('⚠')} Proxy not responding on {url}")

    for d in [DATA_DIR, DATA_DIR / "openrouter_data", DATA_DIR / "nvidia_data", DATA_DIR / "huggingface_data", DATA_DIR / "proxy_data"]:
        if d.exists():
            CONSOLE.print(f"  {green('✔')} {d.relative_to(PROJECT_ROOT)}")
        else:
            issues.append(("Data dir", f"Missing: {d}"))
            CONSOLE.print(f"  {red('✘')} {d.relative_to(PROJECT_ROOT)}")

    CONSOLE.print()
    if issues:
        CONSOLE.print(f"{bold(red(f'{len(issues)} issue(s) found:'))}")
        for name, desc in issues:
            CONSOLE.print(f"  {red('•')} {bold(name)}: {desc}")
        return 1
    else:
        CONSOLE.print(green("All checks passed ✓"))
        return 0

def cmd_doctor_tui(args: list[str] | None = None) -> int:
    """Launch the Atlas Doctor TUI (TypeScript + OpenTUI)."""
    doctor_dir = PROJECT_ROOT / "atlas" / "doctor"
    entry = doctor_dir / "tsrc" / "index.tsx"
    if not entry.exists():
        CONSOLE.print(f"{red('Atlas Doctor entry not found at')} {entry}")
        return cmd_doctor()

    cmd = ["bun", "tsrc/index.tsx"]
    if args:
        cmd.extend(args)
    try:
        result = subprocess.run(cmd, cwd=doctor_dir)
        return result.returncode
    except KeyboardInterrupt:
        return 0
    except FileNotFoundError:
        CONSOLE.print(f"{red('bun not found. Install Bun:')} https://bun.sh")
        return cmd_doctor()
    except Exception as e:
        CONSOLE.print(f"{red('Doctor failed to start:')} {e}")
        return 1


