# ---------------------------------------------------------------------------
# Global commands (start all / stop all / restart all / status all / logs all)
# ---------------------------------------------------------------------------
def cmd_start_all():
    CONSOLE.print(f"{cyan('▶')} Starting all Atlas services...")
    results = []
    results.append(("Proxy", cmd_proxy_start() == 0))
    results.append(("OpenRouter", cmd_openrouter_start() == 0))
    results.append(("NVIDIA", cmd_nvidia_start() == 0))
    results.append(("HuggingFace", cmd_huggingface_start() == 0))
    CONSOLE.print()
    for name, ok in results:
        CONSOLE.print(f"  {checkmark(ok)} {name}")
    return 0 if all(ok for _, ok in results) else 1

def cmd_stop_all():
    CONSOLE.print(f"{cyan('▶')} Stopping all Atlas services...")
    service_action("stop", "atlas-proxy")
    _run(["systemctl", "stop", "openrouter-signup.service"], check=False, capture=True)
    _run(["systemctl", "stop", "nvidia-automation.service"], check=False, capture=True)
    _run(["systemctl", "stop", "huggingface-automation.service"], check=False, capture=True)
    _run(["pkill", "-f", f"{PROJECT_ROOT}/openrouter/scripts/scheduler.py"], check=False, capture=True)
    _run(["pkill", "-f", f"{PROJECT_ROOT}/nvidia/scripts/main.py"], check=False, capture=True)
    _run(["pkill", "-f", f"{PROJECT_ROOT}/huggingface/scripts/hf_scheduler.py"], check=False, capture=True)
    _run(["pkill", "-f", f"{PROJECT_ROOT}/huggingface/scripts/main.py"], check=False, capture=True)
    CONSOLE.print(green("All services stopped"))
    return 0

def cmd_restart_all():
    CONSOLE.print(f"{cyan('▶')} Restarting all Atlas services...")
    cmd_stop_all()
    time.sleep(1)
    return cmd_start_all()

