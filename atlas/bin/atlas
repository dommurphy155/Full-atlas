def cmd_openrouter_keys() -> int:
    or_keys = OR_KEYS_FILE
    if or_keys.exists():
        content = or_keys.read_text().strip()
        keys = [k for k in content.splitlines() if k.strip() and not k.startswith("#")]
        CONSOLE.print(f"\n{bold('OpenRouter Keys')}")
        CONSOLE.print(f"  Total: {cyan(str(len(keys)))}")
        CONSOLE.print()
        for i, k in enumerate(keys, 1):
            CONSOLE.print(f"  {dim(f'{i}.')} {k[:40]}...")
    else:
        CONSOLE.print(f"\n{yellow('No OpenRouter keys found')}")
        CONSOLE.print(f"  Run {cyan('atlas openrouter create')} to generate one")
    return 0

def cmd_openrouter_create() -> int:
    CONSOLE.print(f"\n{cyan('▶')} Creating OpenRouter key...")
    CONSOLE.print(f"  {dim('This requires AgentMail and a Google account login')}")
    CONSOLE.print()

    # Check if AgentMail key is set
    env_file = PROJECT_ROOT / "openrouter" / ".env"
    if env_file.exists():
        from dotenv import load_dotenv
        env = {}
        load_dotenv(env_file, override=False, dotenv_path=env_file)
        if not os.environ.get("AGENTMAIL_API_KEY"):
            # Try loading from .env
            content = env_file.read_text()
            for line in content.splitlines():
                if line.startswith("AGENTMAIL_API_KEY="):
                    os.environ["AGENTMAIL_API_KEY"] = line.split("=", 1)[1].strip()
                    break

    if not os.environ.get("AGENTMAIL_API_KEY"):
        CONSOLE.print(yellow("  AGENTMAIL_API_KEY not found in openrouter/.env"))
        CONSOLE.print(f"  Get one at {cyan('https://agentmail.to/dashboard')}")
        CONSOLE.print(f"  Then add it to {PROJECT_ROOT / 'openrouter' / '.env'}")
        return 1

    # Run the signup automation
    venv_python = PROJECT_ROOT / ".venv" / "bin" / "python"
    if not venv_python.exists():
        venv_python = Path(shutil.which("python3") or "python3")

    signup_script = PROJECT_ROOT / "openrouter" / "scripts" / "signup_automation.py"
    if not signup_script.exists():
        CONSOLE.print(red(f"  ERR: {signup_script} not found"))
        return 1

    with Progress(
        SpinnerColumn("dots12", style="cyan"),
        TextColumn("[bold]{task.description}[/bold]"),
        console=CONSOLE,
    ) as progress:
        task = progress.add_task("Running OpenRouter signup...", status="working...")
        try:
            result = subprocess.run(
                [str(venv_python), str(signup_script)],
                capture_output=True, text=True, timeout=600,
            )
            progress.update(task, status="done")
        except subprocess.TimeoutExpired:
            progress.update(task, status="timed out")
            CONSOLE.print(red("  Signup timed out after 10 minutes"))
            return 1
        except Exception as e:
            progress.update(task, status="failed")
            CONSOLE.print(red(f"  Failed: {e}"))
            return 1

    if result.returncode == 0:
        CONSOLE.print(green("  OpenRouter key created successfully"))
        # Show the key
        or_keys = OR_KEYS_FILE
        if or_keys.exists():
            keys = [k for k in or_keys.read_text().strip().splitlines() if k.strip()]
            CONSOLE.print(f"  Total keys now: {cyan(str(len(keys)))}")
    else:
        CONSOLE.print(red(f"  Signup failed (exit {result.returncode})"))
        if result.stderr:
            CONSOLE.print(dim(result.stderr.strip()[:500]))
    return 0

def cmd_openrouter_import() -> int:
    CONSOLE.print(f"\n{cyan('▶')} Import OpenRouter key")
    CONSOLE.print(f"  Paste your sk-or-... key below")
    CONSOLE.print()

    key = Prompt.ask("OpenRouter API key")
    if not key or not key.startswith("sk-or-"):
        CONSOLE.print(red("  Invalid key format. Must start with sk-or-"))
        return 1

    or_keys = OR_KEYS_FILE
    or_keys.parent.mkdir(parents=True, exist_ok=True)

    # Check for duplicates
    existing = set()
    if or_keys.exists():
        content = or_keys.read_text().strip()
        existing = {k.strip() for k in content.splitlines() if k.strip() and not k.startswith("#")}

    if key in existing:
        CONSOLE.print(yellow("  Key already exists"))
        return 0

    with open(or_keys, "a") as f:
        f.write(f"{key}\n")

    CONSOLE.print(green(f"  Key imported successfully"))
    CONSOLE.print(f"  Total keys: {cyan(str(len(existing) + 1))}")
    return 0

