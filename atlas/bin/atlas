def cmd_nvidia_create() -> int:
    CONSOLE.print(f"\n{cyan('▶')} Creating NVIDIA key...")
    CONSOLE.print(f"  {dim('This requires a Google account login and CAPTCHA')}")
    CONSOLE.print()

    venv_python = PROJECT_ROOT / ".venv" / "bin" / "python"
    if not venv_python.exists():
        venv_python = Path(shutil.which("python3") or "python3")

    nvidia_main = PROJECT_ROOT / "nvidia" / "scripts" / "main.py"
    if not nvidia_main.exists():
        CONSOLE.print(red(f"  ERR: {nvidia_main} not found"))
        return 1

    with Progress(
        SpinnerColumn("dots12", style="cyan"),
        TextColumn("[bold]{task.description}[/bold]"),
        BarColumn(),
        TaskProgressColumn(),
        console=CONSOLE,
    ) as progress:
        task = progress.add_task("Generating NVIDIA key...", total=1)
        try:
            result = subprocess.run(
                [str(venv_python), str(nvidia_main)],
                capture_output=True, text=True, timeout=600,
            )
            progress.update(task, completed=1)
        except subprocess.TimeoutExpired:
            progress.update(task, completed=0)
            CONSOLE.print(red("  Key generation timed out"))
            return 1
        except Exception as e:
            progress.update(task, completed=0)
            CONSOLE.print(red(f"  Failed: {e}"))
            return 1

    if result.returncode == 0:
        CONSOLE.print(green("  NVIDIA key generated successfully"))
        nv_keys = NV_KEYS_FILE
        if nv_keys.exists():
            keys = [k for k in nv_keys.read_text().strip().splitlines() if k.strip()]
            CONSOLE.print(f"  Total keys now: {cyan(str(len(keys)))}")
    else:
        CONSOLE.print(red(f"  Key generation failed (exit {result.returncode})"))
        if result.stderr:
            CONSOLE.print(dim(result.stderr.strip()[:500]))
    return 0

def cmd_nvidia_import() -> int:
