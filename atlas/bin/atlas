#!/usr/bin/env python3
"""atlas — unified CLI for the Atlas Bundle.

Rich-based, interactive CLI with fuzzy matching, custom help, and
progress-driven workflows. Targets Docker/GitHub CLI/Bun quality.
"""
from __future__ import annotations
import argparse, difflib, os, platform, shutil, subprocess, sys, time
from pathlib import Path

# ---------------------------------------------------------------------------
# Bootstrap: if rich is missing (fresh clone), self-install into a venv and
# re-exec, so the very first `atlas` command never shows a raw traceback.
# ---------------------------------------------------------------------------
def _bootstrap() -> None:
    try:
        import rich  # noqa: F401
        return
    except ImportError:
        pass
    root = Path(__file__).resolve().parent.parent.parent
    venv_dir = root / ".venv"
    py = venv_dir / "bin" / "python"
    if not py.exists():
        print("==> First run: creating virtualenv...")
        subprocess.run([sys.executable, "-m", "venv", str(venv_dir)], check=True)
    print("==> Installing core dependencies (one-time)...")
    r = subprocess.run([str(py), "-m", "pip", "install", "--quiet", "rich"], check=False)
    if r.returncode != 0 or not (venv_dir / "lib").exists():
        print("ERR: could not install dependencies. Check your network/python setup.")
        sys.exit(1)
    os.execv(str(py), [str(py), __file__, *sys.argv[1:]])

if __name__ == "__main__" and __package__ in (None, ""):
    _bootstrap()

from rich import box
from rich.console import Console
from rich.panel import Panel
from rich.table import Table
from rich.progress import Progress, SpinnerColumn, TextColumn, BarColumn, TaskProgressColumn
from rich.layout import Layout
from rich.tree import Tree
from rich.text import Text
from rich.prompt import Prompt, Confirm
from rich.spinner import Spinner as RichSpinner
from rich.live import Live
from rich.align import Align
from rich.columns import Columns

def _find_project_root() -> Path:
    script = Path(__file__).resolve()
    candidate = script.parent.parent.parent
    if (candidate / "proxy" / "main.py").exists():
        return candidate.resolve()
    return Path.cwd().resolve()

PROJECT_ROOT = _find_project_root()
ATLAS_DIR = PROJECT_ROOT / "atlas"
DATA_DIR = PROJECT_ROOT / "data"
SYSTEMD_DIR = ATLAS_DIR / "systemd"

# Canonical key file locations
OR_KEYS_FILE = DATA_DIR / "openrouter_data" / "openroute_keys.txt"
NV_KEYS_FILE = DATA_DIR / "nvidia_data" / "nvda_keys.txt"
HF_KEYS_FILE = DATA_DIR / "huggingface_data" / "hf_keys.txt"
PROXY_SERVICE = "atlas-proxy.service"
OPENROUTER_SERVICE = "openrouter-signup.service"
NVIDIA_SERVICE = "nvidia-automation.service"
HF_SERVICE = "huggingface-automation.service"
CONSOLE = Console()
VERSION = "2.0.0"
import logging as _logging
log = _logging.getLogger("atlas-cli")

def _run(cmd, check=True, capture=False, timeout=30):
    try:
        return subprocess.run(cmd, capture_output=capture, text=True, check=check, timeout=timeout)
    except FileNotFoundError:
        CONSOLE.print(f"[red]ERR[/red] Command not found: {cmd[0]}")
        sys.exit(1)
    except subprocess.TimeoutExpired:
        CONSOLE.print(f"[red]ERR[/red] Command timed out: {' '.join(cmd)}")
        sys.exit(1)
    except subprocess.CalledProcessError as e:
        CONSOLE.print(f"[red]ERR[/red] Command failed (exit {e.returncode}): {' '.join(cmd)}")
        if e.stderr:
            CONSOLE.print(f"[dim]{e.stderr.strip()}[/dim]")
        sys.exit(e.returncode)

def has_systemctl(): return shutil.which("systemctl") is not None
def detect_platform():
    s = platform.system().lower()
    return {"linux":"linux","darwin":"macos","windows":"windows"}.get(s,s)
def detect_shell():
    sp = os.environ.get("SHELL","")
    n = Path(sp).name if sp else ""
    if n in ("bash","zsh","fish","sh"): return n
    for c in ("zsh","fish","bash","sh"):
        if shutil.which(c): return c
    return "bash"
def get_proxy_url(): return os.environ.get("ATLAS_PROXY_URL","http://127.0.0.1:8788")
def get_service_name(): return os.environ.get("ATLAS_SERVICE", PROXY_SERVICE)
def _c(code, text): return f"{code}{text}[/]" if CONSOLE.is_terminal else text
def green(t): return f"[green]{t}[/green]"
def cyan(t): return f"[cyan]{t}[/cyan]"
def yellow(t): return f"[yellow]{t}[/yellow]"
def red(t): return f"[red]{t}[/red]"
def bold(t): return f"[bold]{t}[/bold]"
def dim(t): return f"[dim]{t}[/dim]"
def checkmark(ok): return green("✔") if ok else red("✘")
def warn(t): return f"[yellow]⚠ {t}[/yellow]"
def info(t): return f"[cyan]ℹ {t}[/cyan]"
def section(title):
    CONSOLE.print(); CONSOLE.print(f"[bold underline]{title}[/bold underline]"); CONSOLE.print()
def separator():
    CONSOLE.print(); CONSOLE.print("[dim]"+"─"*50+"[/dim]"); CONSOLE.print()

# ---------------------------------------------------------------------------
# Fuzzy matching
# ---------------------------------------------------------------------------
def _fuzzy_match(input_val, candidates, cutoff=0.6):
    return difflib.get_close_matches(input_val, candidates, n=3, cutoff=cutoff)
def _suggest(word, candidates):
    m = _fuzzy_match(word, candidates)
    return m[0] if m else None

# ---------------------------------------------------------------------------
# Service management
# ---------------------------------------------------------------------------
UNIT_HINTS = (
    ("atlas-proxy", "proxy"),
    ("openrouter-signup", "openrouter"),
    ("nvidia-automation", "nvidia"),
    ("huggingface-automation", "huggingface"),
)

def _daemon_backend():
    """DaemonBackend via atlas_core — used when systemctl is unavailable (macOS)."""
    import sys as _sys
    if str(PROJECT_ROOT) not in _sys.path:
        _sys.path.insert(0, str(PROJECT_ROOT))
    from atlas_core.service import get_backend
    return get_backend()

def _daemon_name(service):
    base = str(service).replace(".service", "")
    for hint, name in UNIT_HINTS:
        if hint in base:
            return name
    return None

def service_action(action, service=None):
    service = service or get_service_name()
    if not has_systemctl():
        # No systemd (macOS / minimal Linux): manage via atlas_core daemons.
        dname = _daemon_name(service)
        if not dname or action not in ("start", "stop", "restart"):
            CONSOLE.print(yellow(f"WARN: systemctl not found — cannot {action} {service}"))
            return False
        try:
            be = _daemon_backend()
            ok = {"start": be.start, "stop": be.stop, "restart": be.restart}[action](dname)
        except Exception as e:
            CONSOLE.print(red(f"ERR: {action} {service} failed: {e}"))
            return False
        if ok:
            CONSOLE.print(green(f"OK: {action} {service} (daemon mode)"))
        else:
            CONSOLE.print(red(f"ERR: {action} {service} failed"))
        return bool(ok)
    cmd = ["systemctl", action, service]
    result = _run(cmd, check=False, capture=True)
    if result.returncode == 0:
        CONSOLE.print(green(f"OK: {action} {service}"))
        return True
    else:
        CONSOLE.print(red(f"ERR: {action} {service} failed (exit {result.returncode})"))
        if result.stderr:
            CONSOLE.print(dim(result.stderr.strip()))
        return False

def service_status(service=None):
    service = service or get_service_name()
    if not has_systemctl():
        dname = _daemon_name(service)
        running = False
        if dname:
            try:
                running = _daemon_backend().is_running(dname)
            except Exception:
                running = False
        if running:
            CONSOLE.print(green(f"OK: {service} is active (daemon mode)"))
        else:
            CONSOLE.print(yellow(f"{service}: stopped"))
        return running
    result = _run(["systemctl", "is-active", service], check=False, capture=True)
    status = result.stdout.strip()
    if status == "active":
        CONSOLE.print(green(f"OK: {service} is active"))
        return True
    else:
        CONSOLE.print(yellow(f"{service}: {status or 'unknown'}"))
        return False

def is_service_active(service):
    if not has_systemctl():
        dname = _daemon_name(service)
        if not dname:
            return False
        try:
            return _daemon_backend().is_running(dname)
        except Exception:
            return False
    result = _run(["systemctl", "is-active", service], check=False, capture=True)
    return result.stdout.strip() == "active"

# ---------------------------------------------------------------------------
# Proxy commands
# ---------------------------------------------------------------------------
def cmd_proxy_start():
    CONSOLE.print(f"{cyan('▶')} Starting Atlas proxy...")
    if service_action("start", "atlas-proxy"):
        CONSOLE.print(green("Proxy started"))
        return 0
    return 1

def cmd_proxy_stop():
    CONSOLE.print(f"{cyan('▶')} Stopping Atlas proxy...")
    if service_action("stop", "atlas-proxy"):
        CONSOLE.print(green("Proxy stopped"))
        return 0
    return 1

def _write_runtime_provider(provider: str, model: str = "") -> None:
    """Write the runtime provider config file that the proxy reads at startup."""
    import json
    rp_dir = DATA_DIR / "proxy_data"
    rp_dir.mkdir(parents=True, exist_ok=True)
    rp_file = rp_dir / "runtime_provider.json"
    config = {
        "provider": provider,
        "model": model,
        "timestamp": int(time.time()),
    }
    rp_file.write_text(json.dumps(config, indent=2))
    log.info(f"Runtime provider config written: provider={provider}, model={model or 'default'}")

def cmd_proxy_restart(provider: str = "openrouter", model: str = ""):
    CONSOLE.print(f"{cyan('▶')} Restarting Atlas proxy..." + (f" [{provider}]" + (f" ({model})" if model else "") if provider != "openrouter" else ""))
    # Write runtime provider config before restart
    _write_runtime_provider(provider, model)
    cmd_proxy_stop()
    time.sleep(1)
    return cmd_proxy_start()

PROXY_LOG_FILE = PROJECT_ROOT / "proxy" / "logs" / "atlas-proxy.log"

def cmd_proxy_logs():
    CONSOLE.print(f"{cyan('▶')} Following {PROXY_LOG_FILE.name} (Ctrl-C to exit)...")
    if not PROXY_LOG_FILE.exists():
        CONSOLE.print(yellow(f"No log file yet: {PROXY_LOG_FILE}"))
        CONSOLE.print(dim("  Start the proxy first: atlas start"))
        CONSOLE.print(dim("  Fallback: journalctl -u atlas-proxy.service -f"))
        return 1
    try:
        subprocess.run(["tail", "-n", "40", "-f", str(PROXY_LOG_FILE)], check=False)
    except KeyboardInterrupt:
        CONSOLE.print()
    return 0

def cmd_proxy_status():
    service_status("atlas-proxy")
    url = get_proxy_url()
    CONSOLE.print(f"\n{cyan('Health check')}: {url}/health")
    try:
        import urllib.request
        req = urllib.request.Request(f"{url}/health", headers={"User-Agent": "atlas-cli/2.0"})
        with urllib.request.urlopen(req, timeout=3) as resp:
            data = resp.read().decode()
            CONSOLE.print(green(f"  Proxy responding: {resp.status}"))
            try:
                import json
                parsed = json.loads(data)
                keys = parsed.get("keys", {})
                total = parsed.get("summary", {}).get("total", "unknown")
                CONSOLE.print(f"  Keys loaded: {cyan(str(total))}")
            except Exception:
                pass
    except Exception as e:
        CONSOLE.print(red(f"  Proxy not responding: {e}"))
    CONSOLE.print(f"\n{cyan('Keys')}: {url}/health/keys")
    try:
        import urllib.request
        req = urllib.request.Request(f"{url}/health/keys", headers={"User-Agent": "atlas-cli/2.0"})
        with urllib.request.urlopen(req, timeout=3) as resp:
            CONSOLE.print(green(f"  Keys endpoint: {resp.status}"))
    except Exception as e:
        CONSOLE.print(red(f"  Keys endpoint not responding: {e}"))
    return 0

# ---------------------------------------------------------------------------
# OpenRouter commands
# ---------------------------------------------------------------------------
def cmd_openrouter_start():
    openrouter_dir = PROJECT_ROOT / "openrouter"
    scheduler = openrouter_dir / "scripts" / "scheduler.py"
    if not scheduler.exists():
        CONSOLE.print(red(f"ERR: {scheduler} not found"))
        return 1
    CONSOLE.print(f"{cyan('▶')} Starting OpenRouter automation...")
    result = _run(["pgrep", "-f", f"{PROJECT_ROOT}/openrouter/scripts/scheduler.py"], check=False, capture=True)
    if result.returncode == 0:
        CONSOLE.print(yellow("OpenRouter automation is already running"))
        return 0
    if has_systemctl():
        check = _run(["systemctl", "list-unit-files", OPENROUTER_SERVICE], check=False, capture=True)
        if OPENROUTER_SERVICE in check.stdout:
            return service_action("start", OPENROUTER_SERVICE)
    venv_python = PROJECT_ROOT / ".venv" / "bin" / "python"
    if not venv_python.exists():
        venv_python = Path(shutil.which("python3") or "python3")
    log_file = openrouter_dir / "logs" / "openrouter.log"
    log_file.parent.mkdir(parents=True, exist_ok=True)
    with open(log_file, "a") as log:
        proc = subprocess.Popen(
            [str(venv_python), str(scheduler), "--runs", "0", "--delay", "240"],
            stdout=log, stderr=subprocess.STDOUT, start_new_session=True,
        )
    CONSOLE.print(green(f"OpenRouter automation started (PID {proc.pid})"))
    CONSOLE.print(f"  Logs: {dim(str(log_file))}")
    return 0

def cmd_openrouter_stop():
    CONSOLE.print(f"{cyan('▶')} Stopping OpenRouter automation...")
    if has_systemctl():
        _run(["systemctl", "stop", "openrouter-signup.service"], check=False)
    _run(["pkill", "-f", f"{PROJECT_ROOT}/openrouter/scripts/scheduler.py"], check=False)
    _run(["pkill", "-f", f"{PROJECT_ROOT}/openrouter/scripts/main.py"], check=False)
    _run(["pkill", "-f", f"{PROJECT_ROOT}/openrouter/scripts/signup_automation.py"], check=False)
    CONSOLE.print(green("OpenRouter automation stopped"))
    return 0

def cmd_openrouter_restart():
    CONSOLE.print(f"{cyan('▶')} Restarting OpenRouter automation...")
    cmd_openrouter_stop()
    time.sleep(1)
    return cmd_openrouter_start()

def cmd_openrouter_logs():
    CONSOLE.print(f"{cyan('▶')} Following OpenRouter logs (Ctrl-C to exit)...")
    if not has_systemctl():
        try:
            from atlas_core.process import tail_log
            tail_log("openrouter", follow=True)
        except KeyboardInterrupt:
            pass
        return 0
    cmd = ["journalctl", "-u", OPENROUTER_SERVICE, "-f"]
    try:
        subprocess.run(cmd, check=False)
    except KeyboardInterrupt:
        CONSOLE.print()
    return 0

def cmd_openrouter_status():
    CONSOLE.print(f"\n{bold('OpenRouter Automation')}")
    result = _run(["pgrep", "-f", f"{PROJECT_ROOT}/openrouter/scripts/scheduler.py"], check=False, capture=True)
    if result.returncode == 0:
        CONSOLE.print(f"  {green('✔')} Running (PID {result.stdout.strip()})")
    else:
        CONSOLE.print(f"  {yellow('✘')} Not running")
    if OR_KEYS_FILE.exists():
        count = len([k for k in OR_KEYS_FILE.read_text().strip().splitlines() if k.strip() and not k.startswith("#")])
        CONSOLE.print(f"  Keys: {cyan(str(count))}")
    return 0

