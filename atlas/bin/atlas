    CONSOLE.print(f"{bold('Proxy')}:")
    service_status("atlas-proxy")
    CONSOLE.print(f"\n{bold('OpenRouter Automation')}:")
    result = _run(["pgrep", "-f", f"{PROJECT_ROOT}/openrouter/scripts/scheduler.py"], check=False, capture=True)
    if result.returncode == 0:
        CONSOLE.print(f"  {green('✔')} Running (PID {result.stdout.strip()})")
    else:
        CONSOLE.print(f"  {yellow('✘')} Not running")
    CONSOLE.print(f"\n{bold('NVIDIA Automation')}")
    result = _run(["pgrep", "-f", f"{PROJECT_ROOT}/nvidia/scripts/main.py"], check=False, capture=True)
    if result.returncode == 0:
        CONSOLE.print(f"  {green('✔')} Running (PID {result.stdout.strip()})")
    else:
        CONSOLE.print(f"  {yellow('✘')} Not running")
    CONSOLE.print(f"\n{bold('HuggingFace Automation')}")
    result = _run(["pgrep", "-f", f"{PROJECT_ROOT}/huggingface/scripts/hf_scheduler.py"], check=False, capture=True)
    if result.returncode == 0:
        CONSOLE.print(f"  {green('✔')} Running (PID {result.stdout.strip()})")
    else:
        CONSOLE.print(f"  {yellow('✘')} Not running")
    CONSOLE.print(f"\n{bold('Keys')}:")
    or_keys = OR_KEYS_FILE
    nv_keys = NV_KEYS_FILE
    hf_keys = HF_KEYS_FILE
    CONSOLE.print(f"  OpenRouter: {cyan(str(or_keys))} ({or_keys.stat().st_size if or_keys.exists() else 0} bytes)")
    CONSOLE.print(f"  NVIDIA: {cyan(str(nv_keys))} ({nv_keys.stat().st_size if nv_keys.exists() else 0} bytes)")
    CONSOLE.print(f"  HuggingFace: {cyan(str(hf_keys))} ({hf_keys.stat().st_size if hf_keys.exists() else 0} bytes)")
    CONSOLE.print(f"\n{bold('Proxy Health')}:")
    url = get_proxy_url()
    try:
        import urllib.request
        req = urllib.request.Request(f"{url}/health", headers={"User-Agent": "atlas-cli/2.0"})
        with urllib.request.urlopen(req, timeout=3) as resp:
            CONSOLE.print(f"  {green('✔')} Proxy responding ({resp.status})")
    except Exception as e:
        CONSOLE.print(f"  {red('✘')} Proxy not responding: {e}")
    return 0

def cmd_logs_all():
