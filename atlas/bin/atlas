def cmd_nvidia_start():
    nvidia_dir = PROJECT_ROOT / "nvidia"
    main_script = nvidia_dir / "scripts" / "main.py"
    if not main_script.exists():
        CONSOLE.print(red(f"ERR: {main_script} not found"))
        return 1
    CONSOLE.print(f"{cyan('▶')} Starting NVIDIA key automation...")
    result = _run(["pgrep", "-f", f"{PROJECT_ROOT}/nvidia/scripts/main.py"], check=False, capture=True)
    if result.returncode == 0:
        CONSOLE.print(yellow("NVIDIA automation is already running"))
        return 0
    if has_systemctl():
        check = _run(["systemctl", "list-unit-files", NVIDIA_SERVICE], check=False, capture=True)
        if NVIDIA_SERVICE in check.stdout:
            return service_action("start", NVIDIA_SERVICE)
    venv_python = PROJECT_ROOT / ".venv" / "bin" / "python"
    if not venv_python.exists():
        venv_python = Path(shutil.which("python3") or "python3")
    log_file = nvidia_dir / "logs" / "nvidia.log"
    log_file.parent.mkdir(parents=True, exist_ok=True)
    with open(log_file, "a") as log:
        proc = subprocess.Popen(
            [str(venv_python), str(main_script)],
            stdout=log, stderr=subprocess.STDOUT, start_new_session=True,
        )
    CONSOLE.print(green(f"NVIDIA automation started (PID {proc.pid})"))
    CONSOLE.print(f"  Logs: {dim(str(log_file))}")
    return 0

def cmd_nvidia_stop():
    CONSOLE.print(f"{cyan('▶')} Stopping NVIDIA automation...")
    if has_systemctl():
        _run(["systemctl", "stop", "nvidia-automation.service"], check=False)
    _run(["pkill", "-f", f"{PROJECT_ROOT}/nvidia/scripts/main.py"], check=False)
    CONSOLE.print(green("NVIDIA automation stopped"))
    return 0

def cmd_nvidia_restart():
    CONSOLE.print(f"{cyan('▶')} Restarting NVIDIA automation...")
    cmd_nvidia_stop()
    time.sleep(1)
    return cmd_nvidia_start()

def cmd_nvidia_logs():
    CONSOLE.print(f"{cyan('▶')} Following NVIDIA logs (Ctrl-C to exit)...")
    if not has_systemctl():
        try:
            from atlas_core.process import tail_log
            tail_log("nvidia", follow=True)
        except KeyboardInterrupt:
            pass
        return 0
    cmd = ["journalctl", "-u", NVIDIA_SERVICE, "-f"]
    try:
        subprocess.run(cmd, check=False)
    except KeyboardInterrupt:
        CONSOLE.print()
    return 0

def cmd_nvidia_status():
    CONSOLE.print(f"\n{bold('NVIDIA Automation')}")
    result = _run(["pgrep", "-f", f"{PROJECT_ROOT}/nvidia/scripts/main.py"], check=False, capture=True)
    if result.returncode == 0:
        CONSOLE.print(f"  {green('✔')} Running (PID {result.stdout.strip()})")
    else:
        CONSOLE.print(f"  {yellow('✘')} Not running")
    nv_keys = NV_KEYS_FILE
    if nv_keys.exists():
        count = len([k for k in nv_keys.read_text().strip().splitlines() if k.strip() and not k.startswith("#")])
        CONSOLE.print(f"  Keys: {cyan(str(count))}")
