# OpenRouter signup automation config
# Copy to .env and fill in your keys:
#   cp .env.example .env

# Required: OpenMail API key (https://openmail.sh)
OPENMAIL_API_KEY=

# Optional: OpenRouter API key for post-signup verification
OPENROUTER_API_KEY=

# Optional: Custom Chrome binary path (auto-detected if unset)
# CHROME_BIN=/usr/bin/google-chrome

# Optional: CDP settings (auto-assigned if unset)
# CDP_PORT=9333
# CDP_HOST=127.0.0.1
